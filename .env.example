# Copy to .env and fill in for real runs. Unset DATABASE_URL/GEMINI_API_KEY
# mean: SQLite fallback, and GeminiClient() raising until a key is provided
# (tests never need either — see llm/client.py's FakeLLMClient).

DATABASE_URL=postgresql+psycopg2://admissions:admissions@localhost:5433/admissions
GEMINI_API_KEY=
