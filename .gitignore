# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local file storage (uploaded documents) - never committed. storage/*
# (not storage/) so the !negation below actually works -- git won't descend
# into a wholesale-excluded directory to apply a later exception.
storage/*
!storage/.gitkeep

# Database (Postgres runs via Docker Compose; this is only a local SQLite fallback)
db/*.db
db/*.sqlite3

# Env / secrets
.env
*.env.local

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.next/

# OS / editor
.DS_Store
.vscode/
.idea/
